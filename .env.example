# Optional production access gate. Set APP_AUTH_REQUIRED=true only with both values set.
# Render enables this by default; use a unique strong password in the host's Secret settings.
APP_AUTH_REQUIRED=false
APP_USERNAME=
APP_PASSWORD=

# Optional server-only integrations. Never use VITE_ prefixed names for secrets.

# YouTube Data API v3 (search.list and videos.list)
YOUTUBE_API_KEY=

# Instagram Graph API hashtag search (Business/Creator account; token/user ID from Meta OAuth)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Threads API keyword search (threads_basic + threads_keyword_search token)
THREADS_ACCESS_TOKEN=

# Optional shared Meta Graph API version override (default v23.0)
META_GRAPH_API_VERSION=v23.0

# Google Ads API Keyword Planning (OAuth refresh token + developer token)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Optional: manager account ID if required for the customer account
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional API version override; default v23
GOOGLE_ADS_API_VERSION=v23

# Server port (production `npm start`)
PORT=4173
